  <!-- Auto-deploy: copies the built DLL into this PC's plugins folder and the partner PC's share.
       If the game is running the DLL is locked: close the game and build again. -->
  <!-- Copies the mod into EVERY game folder under $(GamesRoot) that has BepInEx\plugins, plus Adam's PC. -->
  <Target Name="AfterBuild">
    <ItemGroup>
      <CoopGame Include="$([System.IO.Directory]::GetDirectories('$(GamesRoot)'))" />
      <CoopPlugins Include="%(CoopGame.FullPath)\BepInEx\plugins" Condition="Exists('%(CoopGame.FullPath)\BepInEx\plugins')" />
    </ItemGroup>
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="%(CoopPlugins.Identity)" ContinueOnError="true" />
    <Message Importance="high" Text="FarCoopMod.dll -> %(CoopPlugins.Identity)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PartnerPluginsDir)" ContinueOnError="true" Retries="0" Condition="'$(PartnerPluginsDir)' != ''" />
  </Target>
